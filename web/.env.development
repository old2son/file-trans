# 本地开发直连线上 API，不需要在本地跑 Python / SSH 隧道
# 注意：本地每次打开页面也会往线上数据库写一条访问记录
NEXT_PUBLIC_API_URL=https://o2s.fun/pyApi
NEXT_PUBLIC_TOKEN=114514

# 服务器端
PUBLIC_TITLE=文件处理区域

# PDF 转 Excel：Next 服务端代理转发到线上 nginx（/pyApi/ → 127.0.0.1:8001）
# 本地没有 Python 也能用；如果以后在本地跑了服务，改成 http://127.0.0.1:4000 即可
PDF2EXCEL_API=https://o2s.fun/pyApi

# 视频压缩：ffmpeg 可执行文件路径（可选，默认从 PATH 和常见安装目录查找）
# FFMPEG_PATH = 'C:\ffmpeg\bin\ffmpeg.exe'
